# NeuroLearn AI — example environment configuration.
# Copy this file to .env (repo root) and adjust the values. The backend reads
# .env automatically via pydantic-settings. None of these are required for the
# default SQLite + heuristic offline mode.

# --- Application ---
APP_NAME=NeuroLearn AI
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# --- Storage / database ---
# Default uses a local SQLite file under backend/data/. Set to a PostgreSQL URL
# for production, e.g. postgresql+psycopg2://neuro:neuro@db:5432/neurolearn
DATABASE_URL=sqlite:///./data/neurolearn.db
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=50

# --- Local LLMs (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_PRIMARY_MODEL=qwen2.5:3b-instruct
OLLAMA_SECONDARY_MODEL=gemma2:2b-instruct
LLM_TIMEOUT_SECONDS=180
LLM_TEMPERATURE=0.2
LLM_SEED=42
LLM_CONTEXT_SIZE=4096

# --- ML / embeddings ---
# vector_store: numpy (default) | faiss
VECTOR_STORE=numpy
# embedding_backend: tfidf (default, offline) | sentence-transformers
EMBEDDING_BACKEND=tfidf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# --- Validation thresholds ---
DUPLICATE_COSINE_THRESHOLD=0.90
EVIDENCE_SUPPORT_THRESHOLD=0.55
EVIDENCE_PARTIAL_THRESHOLD=0.35

# --- Frontend / CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Demo account (seeded on startup) ---
DEMO_EMAIL=demo@neurolearn.local
DEMO_PASSWORD=demo1234
DEMO_NAME=Demo Student
